# Copy to .env in the repository root and fill in. Never commit .env.

# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Local Postgres from docker-compose.yml (docker compose up -d).
# Compose reads the POSTGRES_* values; the engine reads DATABASE_URL.
# Use a different password in any shared or production environment.
POSTGRES_USER=bet_researcher
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=bet_researcher
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://bet_researcher:local-dev-only@localhost:5432/bet_researcher

# API-Football (https://www.api-football.com)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Google Gemini (https://ai.google.dev)
GEMINI_API_KEY=
# Model name from Google's current model list.
GEMINI_MODEL=
