# Copy to .env in the repository root and fill in. Never commit .env.

# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Local SQLite by default; Postgres URL in production.
DATABASE_URL=sqlite:///./bet_researcher.db

# API-Football (https://www.api-football.com)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Google Gemini (https://ai.google.dev)
GEMINI_API_KEY=
# Model name from Google's current model list.
GEMINI_MODEL=
